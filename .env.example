# Copy to .env if you want to override the defaults.
WEB_PORT=3000
FLUTTER_VERSION=3.47.4
BACKEND_HOST=backend
BACKEND_PORT=8080
API_BASE_URL=/api
MOCK_PORT=8080
MOCK_DELAY_SECONDS=1

# LiteLLM: provider prefix + the model installed locally in Ollama.
LITELLM_MODEL=ollama_chat/qwen3.5:4b
LITELLM_PORT=4000
# Generate a personal key using the commands in README. Do not commit it.
LITELLM_MASTER_KEY=

# Telegram: copy to .env and fill in your personal bot token and private chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_PEER_ID=
# Docker backend address. For a backend on the host: http://host.docker.internal:8080
TELEGRAM_API_BASE_URL=http://backend:8080
